{
  "manifest_version": 3,
  "name": "Kiraya Ingestor",
  "version": "1.0",
  "description": "Extracts rental listings from Facebook Groups and sends them to Kiraya DB.",
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": ["*://*.facebook.com/*"],
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["*://*.facebook.com/*"],
      "js": ["injected.js"],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": ["*://*.facebook.com/*"],
      "js": ["content.js"],
      "css": ["content.css"]
    }
  ]
}
