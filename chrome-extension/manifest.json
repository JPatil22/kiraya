{
  "manifest_version": 3,
  "name": "Kiraya Ingestor",
  "version": "1.0",
  "description": "Extracts rental listings from Facebook Groups and sends them to Kiraya DB.",
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": [
    "*://*.facebook.com/*",
    "*://facebook.com/*",
    "http://localhost/test-extension*",
    "http://127.0.0.1/test-extension*"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.facebook.com/*",
        "*://facebook.com/*",
        "http://localhost/test-extension*",
        "http://127.0.0.1/test-extension*"
      ],
      "js": ["injected.js"],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "*://*.facebook.com/*",
        "*://facebook.com/*",
        "http://localhost/test-extension*",
        "http://127.0.0.1/test-extension*"
      ],
      "js": ["content.js"],
      "css": ["content.css"]
    }
  ]
}
