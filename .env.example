# ---------------------------------------------------------------------------
# Supabase — copy to .env.local and fill in from your Supabase project settings
# (Project Settings → API). NEXT_PUBLIC_* values are safe to expose client-side.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. NEVER prefix with NEXT_PUBLIC. Used by admin/service scripts only.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---------------------------------------------------------------------------
# App config
# ---------------------------------------------------------------------------
# The single locality this deployment serves (slug must exist in `localities`).
NEXT_PUBLIC_ACTIVE_LOCALITY_SLUG=pune

# Days after which a listing's `last_verified_at` is considered stale (MVP3).
NEXT_PUBLIC_VERIFY_STALE_DAYS=7

# ---------------------------------------------------------------------------
# OPEN MODE — pre-deployment sandbox
# "true" removes the auth gate entirely: every route is reachable without
# signing in, and the app acts as one of the seeded dev identities (switch the
# acting role from the site header). Requires `npm run db:seed`.
#
# Anything other than the exact string "true" — including leaving this unset —
# restores the real phone-OTP gate. Leave it OUT of any deployed environment.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_OPEN_MODE=true

# ---------------------------------------------------------------------------
# FIXTURES — UI-only mode, no database at all
# "true" serves every query from in-memory sample data (src/lib/fixtures), so
# the whole app can be clicked through before a Supabase project exists.
#
# It renders the screens; it does NOT exercise RLS, properties_guard, the
# log_property_changes audit trigger, v_listings_public, or any constraint.
# Turn it off the moment a real database is linked.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_USE_FIXTURES=true

# ---------------------------------------------------------------------------
# Phone OTP (MVP1) — dormant while open mode is on
# Configure the SMS provider in the Supabase Dashboard:
#   Authentication → Providers → Phone (enable) → choose provider.
# For India, the provider must be DLT-registered (TRAI). See docs/PRD.md.
# In local dev you can read the OTP from `supabase functions`/inbucket logs.
# ---------------------------------------------------------------------------
