{
  "name": "kiraya",
  "version": "0.1.0",
  "private": true,
  "description": "Tenant-first rental platform for a single Indian locality — verified tenants, fresh availability, transparent history.",
  "scripts": {
    "dev": "next dev",
    "prebuild": "node scripts/check-env.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:reset": "supabase db reset",
    "db:push": "supabase db push",
    "db:seed": "node scripts/seed-dev.mjs",
    "verify:rls": "node scripts/verify-rls.mjs",
    "db:types": "supabase gen types typescript --local > src/types/database.ts"
  },
  "dependencies": {
    "@radix-ui/react-label": "^2.1.1",
    "@radix-ui/react-select": "^2.1.4",
    "@radix-ui/react-slot": "^1.1.1",
